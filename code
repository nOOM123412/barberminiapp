@dp.callback_query(F.data == "book")
async def book_start(cb: CallbackQuery, state: FSMContext):
    await state.set_state(Booking.choosing_service)
    await cb.message.edit_text("✂️ <b>Шаг 1 из 4 — услуга</b>\n━━━━━━━━━━━━━━━━━━\n\nВыберите услугу:",
                               reply_markup=services_kb())
    await cb.answer()


@dp.callback_query(Booking.choosing_service, F.data.startswith("svc_"))
async def choose_service(cb: CallbackQuery, state: FSMContext):
    key = cb.data.replace("svc_", "")
    await state.update_data(service=key)
    await state.set_state(Booking.choosing_master)
    s = SERVICES[key]
    await cb.message.edit_text(
        f"{s['emoji']} <b>{s['name']}</b> · {s['price']} ₽\n━━━━━━━━━━━━━━━━━━\n\n👨‍🔧 <b>Шаг 2 из 4 — мастер</b>\n\nВыберите мастера:",
        reply_markup=masters_kb())
    await cb.answer()


@dp.callback_query(Booking.choosing_master, F.data.startswith("mst_"))
async def choose_master(cb: CallbackQuery, state: FSMContext):
    key = cb.data.replace("mst_", "")
    await state.update_data(master=key)
    await state.set_state(Booking.choosing_date)
    m = MASTERS[key]
    await cb.message.edit_text(
        f"👨‍🔧 <b>Мастер {key}. {m['name']}</b>\n━━━━━━━━━━━━━━━━━━\n\n📅 <b>Шаг 3 из 4 — дата</b>\n\nВыберите день:",
        reply_markup=dates_kb())
    await cb.answer()


@dp.callback_query(F.data == "back_masters")
async def back_to_masters(cb: CallbackQuery, state: FSMContext):
    await state.set_state(Booking.choosing_master)
    await cb.message.edit_text("👨‍🔧 <b>Шаг 2 из 4 — мастер</b>\n━━━━━━━━━━━━━━━━━━\n\nВыберите мастера:",
