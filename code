@dp.callback_query(Booking.choosing_date, F.data.startswith("date_"))
async def choose_date(cb: CallbackQuery, state: FSMContext):
    date_str = cb.data.replace("date_", "")
    await state.update_data(date=date_str)
    await state.set_state(Booking.choosing_time)
    d = datetime.strptime(date_str, "%Y-%m-%d").strftime("%d.%m.%Y")
    await cb.message.edit_text(f"📅 <b>{d}</b>\n━━━━━━━━━━━━━━━━━━\n\n🕐 <b>Шаг 4 из 4 — время</b>\n\nВыберите время:",
