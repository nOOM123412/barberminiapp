        f"⭐ {SHOP_RATING}\n"
        f"📍 {SHOP_ADDRESS}\n"
        f"🕐 {WORK_HOURS}\n"
        f"📞 {SHOP_PHONE}\n\n"
        f"<i>Приходите — мы знаем, что делаем.</i>"
    )
    await cb.message.edit_text(text, reply_markup=back_kb("back_main"))
