@dp.callback_query(F.data == "back_dates")
async def back_to_dates(cb: CallbackQuery, state: FSMContext):
    await state.set_state(Booking.choosing_date)
    await cb.message.edit_text("📅 <b>Шаг 3 из 4 — дата</b>\n━━━━━━━━━━━━━━━━━━\n\nВыберите день:",
                               reply_markup=dates_kb())
    await cb.answer()


@dp.callback_query(Booking.choosing_time, F.data.startswith("time_"))
async def choose_time(cb: CallbackQuery, state: FSMContext):
    time_str = cb.data.replace("time_", "")
    await state.update_data(time=time_str)
    await state.set_state(Booking.confirming)
    data = await state.get_data()
    s = SERVICES[data["service"]];
    m = MASTERS[data["master"]]
    d = datetime.strptime(data["date"], "%Y-%m-%d").strftime("%d.%m.%Y")
    text = f"📋 <b>Проверьте запись</b>\n━━━━━━━━━━━━━━━━━━\n\n💈 <b>{SHOP_NAME}</b>\n\n{s['emoji']} {s['name']} — <b>{s['price']} ₽</b>\n👨‍🔧 {m['name']}\n📅 {d} в {time_str}\n\n<i>Всё верно?</i>"
    await cb.message.edit_text(text, reply_markup=confirm_kb())
    await cb.answer()


@dp.callback_query(Booking.confirming, F.data == "confirm_yes")
async def confirm_yes(cb: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    s = SERVICES[data["service"]];
    m = MASTERS[data["master"]]
    d = datetime.strptime(data["date"], "%Y-%m-%d").strftime("%d.%m.%Y")
    booking = {"user_id": cb.from_user.id, "user_name": cb.from_user.full_name, "date": data["date"],
               "time": data["time"], "master": m["name"], "service": s["name"], "service_key": data["service"],
               "price": s["price"]}
    bookings.append(booking)
    text = f"✅ <b>Вы записаны!</b>\n━━━━━━━━━━━━━━━━━━\n\n💈 <b>{SHOP_NAME}</b>\n\n{s['emoji']} {s['name']} — <b>{s['price']} ₽</b>\n👨‍🔧 {m['name']}\n📅 <b>{d} в {data['time']}</b>\n\n📍 {SHOP_ADDRESS}\n📞 {SHOP_PHONE}"
    await cb.message.edit_text(text, reply_markup=main_menu_kb())
    await state.clear()


