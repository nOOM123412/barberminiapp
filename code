        f"📍 {SHOP_ADDRESS}\n"
        f"🕐 {WORK_HOURS}\n"
        f"📞 {SHOP_PHONE}"
    )
    await cb.message.edit_text(text, reply_markup=main_menu_kb())
    await cb.answer()

