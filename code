    await cb.message.edit_text(text, reply_markup=main_menu_kb())
    await cb.answer()


# --- ИНТЕГРАЦИЯ MINI APP (Ловим данные из WebApp) ---
@dp.message(F.web_app_data)
async def web_app_data_handler(msg: Message):
    try:
        data = json.loads(msg.web_app_data.data)

        s = SERVICES.get(data["service_id"])
        m = MASTERS.get(data["master_id"])
        d_str = data["date"]
        t_str = data["time"]

        if not s or not m:
            await msg.answer("Ошибка данных.")
            return

        d_formatted = datetime.strptime(d_str, "%Y-%m-%d").strftime("%d.%m.%Y")

        # Сохраняем запись
        booking = {
            "user_id": msg.from_user.id,
            "user_name": msg.from_user.full_name,
            "date": d_str,
            "time": t_str,
            "master": m["name"],
            "service": s["name"],
            "service_key": data["service_id"],
            "price": s["price"],
        }
        bookings.append(booking)

        # Отправляем подтверждение клиенту в бот
        text = (
            f"✅ <b>Вы записаны!</b>\n"
            f"━━━━━━━━━━━━━━━━━━\n\n"
            f"💈 <b>{SHOP_NAME}</b>\n\n"
            f"{s['emoji']} {s['name']} — <b>{s['price']} ₽</b>\n"
            f"👨‍🔧 Мастер: <b>{m['name']}</b>\n"
            f"📅 <b>{d_formatted} в {t_str}</b>\n\n"
            f"📍 {SHOP_ADDRESS}\n"
            f"📞 {SHOP_PHONE}\n\n"
            f"<i>Ждем вас!</i>"
        )

        # Клавиатура с кнопкой возврата в Mini App (к своим записям)
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="📱 Мои записи в приложении", web_app=WebAppInfo(url=WEBAPP_URL))]
        ])

        await msg.answer(text, reply_markup=kb)

        # Уведомление админу
        if ADMIN_CHAT_ID:
            await bot.send_message(
                ADMIN_CHAT_ID,
                f"🔔 <b>Новая запись (Mini App)!</b>\n"
                f"👤 {msg.from_user.full_name}\n"
                f"✂️ {s['name']} - {s['price']} ₽\n"
                f"👨‍🔧 {m['name']}\n"
                f"📅 {d_formatted} в {t_str}"
            )

    except Exception as e:
        logging.error(f"Ошибка обработки WebApp: {e}")
        await msg.answer("Произошла ошибка при сохранении записи. Попробуйте еще раз.")


# --- Кнопка "Мои записи" (в чате) ---
@dp.callback_query(F.data == "my_bookings")
async def my_bookings(cb: CallbackQuery):
    user_bookings = [b for b in bookings if b["user_id"] == cb.from_user.id]
    if not user_bookings:
        text = "📋 <b>Мои записи</b>\n━━━━━━━━━━━━━━━━━━\n\nУ вас пока нет активных записей."
    else:
        text = "📋 <b>Ваши записи</b>\n━━━━━━━━━━━━━━━━━━\n\n"
        for i, b in enumerate(user_bookings, 1):
            d = datetime.strptime(b['date'], "%Y-%m-%d").strftime("%d.%m.%Y")
            s = SERVICES.get(b.get('service_key'), {"emoji": "✂️"})
            text += f"<b>Запись #{i}</b>\n{s['emoji']} {b['service']} — {b['price']} ₽\n👨‍🔧 Мастер: {b['master']}\n📅 {d} в {b['time']}\n\n"
    await cb.message.edit_text(text, reply_markup=back_kb("back_main"))
    await cb.answer()


