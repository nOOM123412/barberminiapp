# --- ПРИЕМ ДАННЫХ ИЗ MINI APP ---
@dp.message(F.web_app_data)
async def web_app_data_handler(msg: Message):
    try:
        data = json.loads(msg.web_app_data.data)
        logging.info(f"Получены данные из WebApp: {data}")
        
        db = SessionLocal() # Открываем сессию БД

        if data.get("action") == "book":
            s = SERVICES.get(data["service_id"])
            m = MASTERS.get(data["master_id"])
            d_str, t_str = data["date"], data["time"]
            d_formatted = datetime.strptime(d_str, "%Y-%m-%d").strftime("%d.%m.%Y")

            # Проверка на дубликат (на всякий случай)
            existing = db.query(Booking).filter(
                Booking.master_id == data["master_id"],
                Booking.date == d_str,
                Booking.time == t_str
            ).first()

            if existing:
                await msg.answer("❌ Увы, это время только что заняли. Выберите другое.")
                db.close()
                return

            # Сохраняем в БД
            new_booking = Booking(
                user_id=msg.from_user.id,
                user_name=msg.from_user.full_name,
                username=msg.from_user.username,
                service_id=data["service_id"],
                master_id=data["master_id"],
                date=d_str,
                time=t_str
            )
            db.add(new_booking)
            db.commit()

            # Подтверждение клиенту
            client_text = (
                f"✅ <b>Вы записаны!</b>\n"
                f"━━━━━━━━━━━━━━━━━━\n\n"
                f"💈 <b>{SHOP_NAME}</b>\n\n"
                f"{s['emoji']} {s['name']} — <b>{s['price']} ₽</b>\n"
                f"👨‍🔧 Мастер: <b>{m['name']}</b>\n"
                f"📅 <b>{d_formatted} в {t_str}</b>\n\n"
                f"📍 {SHOP_ADDRESS}\n"
                f"📞 {SHOP_PHONE}"
            )
            await msg.answer(client_text)

            # Уведомление админу
            if ADMIN_CHAT_ID and str(ADMIN_CHAT_ID) != "123456789":
                admin_text = (
                    f"🔔 <b>НОВАЯ ЗАПИСЬ!</b>\n"
                    f"━━━━━━━━━━━━━━━━━━\n\n"
                    f"👤 Клиент: <b>{msg.from_user.full_name}</b>\n"
                    f"🆔 Юзернейм: @{msg.from_user.username if msg.from_user.username else 'нет'}\n\n"
                    f"✂️ Услуга: <b>{s['name']}</b>\n"
                    f"💰 Стоимость: <b>{s['price']} ₽</b>\n"
                    f"👨‍🔧 Мастер: <b>{m['name']}</b>\n"
                    f"📅 Время: <b>{d_formatted} в {t_str}</b>"
                )
                try:
                    await bot.send_message(ADMIN_CHAT_ID, admin_text)
                except Exception as e:
                    logging.error(f"ОШИБКА отправки админу: {e}")

        elif data.get("action") == "support":
            support_text = data["text"]
            new_msg = SupportMessage(
                user_id=msg.from_user.id,
                user_name=msg.from_user.full_name,
                message=support_text
            )
            db.add(new_msg)
            db.commit()

            if ADMIN_CHAT_ID and str(ADMIN_CHAT_ID) != "123456789":
                try:
                    await bot.send_message(ADMIN_CHAT_ID, f"💬 <b>Обращение в поддержку</b>\n\n👤 От: {msg.from_user.full_name} (@{msg.from_user.username if msg.from_user.username else 'нет'})\n\n📝 Сообщение:\n{support_text}")
                    await msg.answer("✅ Ваше сообщение отправлено в поддержку. Мы скоро свяжемся с вами!")
                except Exception as e:
                    logging.error(f"ОШИБКА отправки админу (поддержка): {e}")
        
        db.close() # Закрываем сессию

    except Exception as e:
        logging.error(f"Ошибка WebApp: {e}")

